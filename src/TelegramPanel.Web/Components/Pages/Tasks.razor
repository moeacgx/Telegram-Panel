    private static string StripRuntimeFields(string config)
    {
        try
        {
            var node = JsonNode.Parse(config);
            if (node is JsonObject obj)
            {
                obj.Remove("recent_failures");
                return obj.ToJsonString(new JsonSerializerOptions { WriteIndented = true });
            }
        }
        catch
        {
            // 配置非 JSON 或解析失败时直接回退到原内容
        }

        return config;
    }

    private static bool HasStatus(BatchTask task, string status)
    {
        return string.Equals(GetDisplayStatus(task), status, StringComparison.OrdinalIgnoreCase);
    }

    private bool CanPauseTask(BatchTask task)
    {
        var capabilities = GetTaskDefinition(task)?.Definition.TaskCenter;
        return capabilities?.CanPause == true && task.Status is "running" or "pending";
    }

    private bool CanResumeTask(BatchTask task)
    {
        var capabilities = GetTaskDefinition(task)?.Definition.TaskCenter;
        return capabilities?.CanResume == true && HasStatus(task, "paused");
    }

    private bool CanEditTask(BatchTask task)
    {
        var definition = GetTaskDefinition(task);
        if (definition == null)
            return false;

        var capabilities = definition.Definition.TaskCenter;
        if (!capabilities.CanEdit)
            return false;

        var hasEditor = ModuleTaskEditorComponentResolver.ResolveEditEditor(definition) != null;
        var hasStandaloneRoute = !string.IsNullOrWhiteSpace(definition.Definition.CreateRoute);
        if (!hasEditor && !hasStandaloneRoute)
            return false;

        var status = GetDisplayStatus(task);
        return status is not ("pending" or "running") || capabilities.AutoPauseBeforeEdit;
    }

    private bool CanRerunTask(BatchTask task)
    {
        if (!IsHistoryStatus(GetDisplayStatus(task)))
            return false;

        return GetTaskDefinition(task)?.Definition.TaskCenter.CanRerun == true;
    }

    private bool CanCancelTask(BatchTask task)
    {
        var status = GetDisplayStatus(task);
        if (status is not ("pending" or "running" or "paused"))
            return false;

        return true;
    }

    private static List<string> ExtractBotAdminFailureLines(BatchTask task)
    {
        var lines = new List<string>();
        if (!IsBotAdminTask(task.TaskType) || string.IsNullOrWhiteSpace(task.Config) || task.Failed <= 0)
            return lines;

        try
        {
            using var doc = JsonDocument.Parse(task.Config);
            var root = doc.RootElement;

            if (root.TryGetProperty("FailureLines", out var failureLinesElement)
                && failureLinesElement.ValueKind == JsonValueKind.Array)
            {
                foreach (var lineElement in failureLinesElement.EnumerateArray())
                {
                    var line = (lineElement.GetString() ?? string.Empty).Trim();
                    if (line.Length > 0)
                        lines.Add(line);
                }

                if (lines.Count > 0)
                    return lines;
            }

            if (root.TryGetProperty("Failures", out var failuresElement)
                && failuresElement.ValueKind == JsonValueKind.Array)
            {
                var failures = new List<BotAdminTaskFailureItem>();
                foreach (var item in failuresElement.EnumerateArray())
                {
                    if (item.ValueKind != JsonValueKind.Object)
                        continue;

                    var failure = new BotAdminTaskFailureItem
                    {
                        ChannelTelegramId = item.TryGetProperty("ChannelTelegramId", out var channelId) && channelId.TryGetInt64(out var id) ? id : 0,
                        ChannelTitle = item.TryGetProperty("ChannelTitle", out var channelTitle) ? channelTitle.GetString() ?? string.Empty : string.Empty,
                        Username = item.TryGetProperty("Username", out var username) ? username.GetString() : null,
                        UserId = item.TryGetProperty("UserId", out var userId) && userId.TryGetInt64(out var uid) ? uid : null,
                        Reason = item.TryGetProperty("Reason", out var reason) ? reason.GetString() ?? string.Empty : string.Empty
                    };

                    failures.Add(failure);
                }

                if (failures.Count > 0)
                    lines = BotAdminTaskFailureFormatter.BuildLines(failures);
            }
        }
        catch
        {
            // 配置异常时回退到默认展示，不中断详情弹窗。
        }

        return lines;
    }

    private bool TryBuildUserChatActiveDetails(BatchTask task, out string details)
    {
        details = string.Empty;
        if (!IsUserChatActiveTask(task.TaskType) || string.IsNullOrWhiteSpace(task.Config))
            return false;

        try
        {
            using var doc = JsonDocument.Parse(task.Config);
            var root = doc.RootElement;

            var categoryText = BuildSelectedCategorySummary(root);
            var maxMessages = root.TryGetProperty("max_messages", out var maxMessagesEl) && maxMessagesEl.TryGetInt32(out var mm) ? mm : 0;
            var accountMode = root.TryGetProperty("account_mode", out var accountModeEl) ? (accountModeEl.GetString() ?? "").Trim() : "";
            var targetMode = root.TryGetProperty("target_mode", out var targetModeEl) ? (targetModeEl.GetString() ?? "").Trim() : "";
            var messageMode = root.TryGetProperty("message_mode", out var messageModeEl) ? (messageModeEl.GetString() ?? "").Trim() : "";
            var delayMin = root.TryGetProperty("delay_min_ms", out var delayMinEl) && delayMinEl.TryGetInt32(out var dmin) ? dmin : 0;
            var delayMax = root.TryGetProperty("delay_max_ms", out var delayMaxEl) && delayMaxEl.TryGetInt32(out var dmax) ? dmax : 0;
            var targetCount = root.TryGetProperty("targets", out var targetsEl) && targetsEl.ValueKind == JsonValueKind.Array
                ? targetsEl.GetArrayLength()
                : 0;
            var dictCount = root.TryGetProperty("dictionary", out var dictEl) && dictEl.ValueKind == JsonValueKind.Array
                ? dictEl.GetArrayLength()
                : 0;
            var messageRuleCount = root.TryGetProperty("message_rules", out var rulesEl) && rulesEl.ValueKind == JsonValueKind.Array && rulesEl.GetArrayLength() > 0
                ? rulesEl.GetArrayLength()
                : dictCount;
            var actionMode = root.TryGetProperty("message_action_mode", out var actionModeEl) ? (actionModeEl.GetString() ?? "send_generated_text").Trim() : "send_generated_text";
            var isForwardMode = string.Equals(actionMode, "forward_url", StringComparison.Ordinal);
            var forwardSourceCount = root.TryGetProperty("forward_source_urls", out var forwardEl) && forwardEl.ValueKind == JsonValueKind.Array
                ? forwardEl.GetArrayLength()
                : 0;
            var replyToMessage = root.TryGetProperty("reply_to_message_id", out var replyIdEl) && replyIdEl.TryGetInt32(out var replyId) && replyId > 0
                ? replyId.ToString()
                : root.TryGetProperty("reply_to_message_url", out var replyUrlEl) ? (replyUrlEl.GetString() ?? "").Trim() : "";
            var forwardMode = root.TryGetProperty("forward_mode", out var forwardModeEl) ? (forwardModeEl.GetString() ?? "").Trim() : "";
            var skipIfLastMessageFromSelf = root.TryGetProperty("skip_if_last_message_from_self", out var skipEl) && skipEl.ValueKind == JsonValueKind.True;

            var lines = new List<string>();
            if (root.TryGetProperty("recent_failures", out var failuresEl) && failuresEl.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in failuresEl.EnumerateArray())
                {
                    if (item.ValueKind != JsonValueKind.Object)
                        continue;

                    var account = item.TryGetProperty("account", out var accountEl) ? (accountEl.GetString() ?? "").Trim() : "";
                    var target = item.TryGetProperty("target", out var targetEl) ? (targetEl.GetString() ?? "").Trim() : "";
                    var reason = item.TryGetProperty("reason", out var reasonEl) ? (reasonEl.GetString() ?? "").Trim() : "";
                    var timeRaw = item.TryGetProperty("time_utc", out var timeEl) ? (timeEl.GetString() ?? "").Trim() : "";
                    var time = FormatTaskFailureTime(timeRaw);

                    var line = $"{(account.Length == 0 ? "-" : account)} -> {(target.Length == 0 ? "-" : target)}：{(reason.Length == 0 ? "失败" : reason)}";
                    if (time.Length > 0)
                        line = $"{line}（{time}）";
                    lines.Add(line);
                }
            }

            details += "\n配置摘要:\n";
            details += $"分类: {categoryText}\n";
            details += $"目标数: {targetCount}\n";
            details += $"发送动作: {(isForwardMode ? "转发消息链接" : "发送消息规则")}\n";
            details += isForwardMode ? $"转发来源数: {forwardSourceCount}\n" : $"消息规则数: {messageRuleCount}\n";
            details += isForwardMode ? $"转发方式: {(string.Equals(forwardMode, "hide_attribution", StringComparison.Ordinal) ? "不带引用转发" : "带引用转发")}\n" : $"回复消息: {(replyToMessage.Length > 0 ? replyToMessage : "未设置")}\n";
            details += $"去重发送: {(skipIfLastMessageFromSelf ? "启用（上一条仍是当前账号则跳过）" : "关闭")}\n";
            details += $"账号模式: {NormalizeTaskModeDisplay(accountMode)}\n";
            details += $"目标模式: {NormalizeTaskModeDisplay(targetMode)}\n";
            details += $"内容模式: {NormalizeTaskModeDisplay(messageMode)}\n";
            details += $"间隔: {FormatDelaySeconds(delayMin)} ~ {FormatDelaySeconds(delayMax)} 秒\n";
            details += $"最多发送: {(maxMessages <= 0 ? "持续运行（直到取消）" : maxMessages.ToString())}\n";

            if (lines.Count > 0)
            {
                details += "\n最近失败:\n";
                details += string.Join('\n', lines.TakeLast(20));
            }

            return true;
        }
        catch
        {
            return false;
        }
    }

    private static string FormatDelaySeconds(int milliseconds)
    {
        if (milliseconds <= 0)
            return "0";

        var seconds = milliseconds / 1000d;
        return seconds.ToString("0.###");
    }

    private string FormatTaskFailureTime(string? rawTime)
    {
        if (string.IsNullOrWhiteSpace(rawTime))
            return string.Empty;

        if (DateTimeOffset.TryParse(rawTime, out var parsed))
            return TimeZone.Format(parsed.UtcDateTime, "yyyy-MM-dd HH:mm:ss");

        return rawTime;
    }

    private static string BuildSelectedCategorySummary(JsonElement root)
    {
        var ids = ExtractSelectedCategoryIds(root);
        var names = ExtractSelectedCategoryNames(root);
        var count = Math.Max(ids.Count, names.Count);
        if (count == 0)
            return "-";

        var parts = new List<string>();
        for (var i = 0; i < count; i++)
        {
            var id = i < ids.Count ? ids[i] : 0;
            var name = i < names.Count ? names[i] : string.Empty;

            if (id > 0 && name.Length > 0)
                parts.Add($"{name} (#{id})");
            else if (id > 0)
                parts.Add($"#{id}");
            else if (name.Length > 0)
                parts.Add(name);
        }

        return parts.Count == 0 ? "-" : string.Join(", ", parts);
    }

    private static List<int> ExtractSelectedCategoryIds(JsonElement root)
    {
        var ids = new List<int>();
        if (root.TryGetProperty("category_ids", out var idsEl) && idsEl.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in idsEl.EnumerateArray())
            {
                if (item.TryGetInt32(out var id) && id > 0)
                    ids.Add(id);
            }
        }

        if (ids.Count == 0 && root.TryGetProperty("category_id", out var categoryIdEl) && categoryIdEl.TryGetInt32(out var categoryId) && categoryId > 0)
            ids.Add(categoryId);

        return ids.Distinct().ToList();
    }

    private static List<string> ExtractSelectedCategoryNames(JsonElement root)
    {
        var names = new List<string>();
        if (root.TryGetProperty("category_names", out var namesEl) && namesEl.ValueKind == JsonValueKind.Array)
        {
            foreach (var item in namesEl.EnumerateArray())
            {
                var name = (item.GetString() ?? string.Empty).Trim();
                if (name.Length > 0)
                    names.Add(name);
            }
        }

        if (names.Count == 0 && root.TryGetProperty("category_name", out var categoryNameEl))
        {
            var fallbackName = (categoryNameEl.GetString() ?? string.Empty).Trim();
            if (fallbackName.Length > 0)
                names.Add(fallbackName);
        }

        return names.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    }

    private static string NormalizeTaskModeDisplay(string? mode)
