    private static string GetChatGroupName(JsonElement root, string objectType)
    {
        var isGroup = objectType == ChannelGroupAutomationTaskObjectTypes.Group;
        var name = GetJsonString(root, isGroup ? "group_category_name" : "channel_group_name", "");
        var id = GetJsonInt(root, isGroup ? "group_category_id" : "channel_group_id", 0);

        if (!string.IsNullOrWhiteSpace(name) && id > 0)
            return $"{name} (#{id})";
        if (!string.IsNullOrWhiteSpace(name))
            return name;
        if (id > 0)
            return $"#{id}";

        return isGroup ? "未分类" : "未分组";
    }

    private static string GetTargetChatGroupName(JsonElement root, string objectType)
    {
        var isGroup = objectType == ChannelGroupAutomationTaskObjectTypes.Group;
        var idKey = isGroup ? "target_group_category_id" : "target_channel_group_id";
        if (!root.TryGetProperty(idKey, out var idElement) || idElement.ValueKind == JsonValueKind.Null)
            return isGroup ? "保持原分类" : "保持原分组";

        var name = GetJsonString(root, isGroup ? "target_group_category_name" : "target_channel_group_name", "");
        var id = GetJsonInt(root, idKey, 0);
        if (!string.IsNullOrWhiteSpace(name) && id > 0)
            return $"{name} (#{id})";
        if (!string.IsNullOrWhiteSpace(name))
            return name;
        if (id > 0)
            return $"#{id}";

        return isGroup ? "未分类" : "未分组";
    }

