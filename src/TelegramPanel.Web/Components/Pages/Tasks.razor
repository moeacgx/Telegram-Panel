</MudCard>

@code {
    private List<BatchTask> tasks = new();
    private List<ScheduledTask> scheduledTasks = new();
    private bool loading = true;
    private string historyStatusFilter = "all";
    private string filterCategory = "all";

    private PeriodicTimer? refreshTimer;
    private CancellationTokenSource? refreshCts;

    private IEnumerable<BatchTask> categoryFilteredTasks =>
        tasks.Where(t => filterCategory == "all" || GetCategory(t.TaskType) == filterCategory);

    private IEnumerable<BatchTask> activeTasks =>
        categoryFilteredTasks
            .Where(t => IsActiveStatus(GetDisplayStatus(t)))
            .OrderBy(t => t.CreatedAt);

    private IEnumerable<BatchTask> historyTasks =>
        categoryFilteredTasks
            .Where(t => IsHistoryStatus(GetDisplayStatus(t)))
            .Where(t => historyStatusFilter == "all" || GetDisplayStatus(t) == historyStatusFilter)
            .OrderByDescending(t => t.CompletedAt ?? t.CreatedAt);

    private IEnumerable<string> AvailableCategories =>
        Contributions.Tasks
            .Select(x => (x.Definition.Category ?? "").Trim())
            .Where(x => x.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();

        refreshCts = new CancellationTokenSource();
        refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _ = Task.Run(async () =>
        {
            try
            {
                while (await refreshTimer.WaitForNextTickAsync(refreshCts.Token))
                {
                    if (tasks.Any(t => t.Status is "pending" or "running")
                        || scheduledTasks.Any(t => string.Equals(t.Status, ScheduledTaskStatuses.Enabled, StringComparison.OrdinalIgnoreCase)))
                    {
                        await InvokeAsync(LoadTasks);
                    }
                }
            }
            catch (OperationCanceledException)
            {
                // ignore
            }
        });
    }

    private async Task LoadTasks()
    {
        loading = true;
        try
        {
            var taskList = await TaskManagement.GetRecentTasksAsync(100);
            tasks = taskList.OrderByDescending(t => t.CreatedAt).ToList();
            scheduledTasks = (await ScheduledTaskManagement.GetAllAsync())
                .OrderByDescending(x => x.CreatedAt)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"加载失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }

    public void Dispose()
    {
        try
        {
            refreshCts?.Cancel();
        }
        catch
        {
            // ignore
        }
        finally
        {
            refreshTimer?.Dispose();
            refreshCts?.Dispose();
        }
    }

    private double GetProgress(BatchTask task)
    {
        if (task.Total <= 0)
            return 0;

        var value = (double)Math.Max(0, task.Completed) / task.Total * 100;
        if (double.IsNaN(value) || double.IsInfinity(value))
            return 0;

        return Math.Clamp(value, 0, 100);
    }

    private string GetCategory(string taskType)
    {
        if (string.IsNullOrWhiteSpace(taskType))
            return "other";

        if (Contributions.TaskTypeToDefinition.TryGetValue(taskType, out var reg))
        {
            var c = (reg.Definition.Category ?? "").Trim();
            return string.IsNullOrWhiteSpace(c) ? "other" : c;
        }

        // fallback：兼容历史任务
        return taskType switch
        {
            BatchTaskTypes.UserChatActive => "user",
            BatchTaskTypes.BotChannelSetAdminsByAccount => "bot",
            BatchTaskTypes.BotSetAdmins => "bot",
            BatchTaskTypes.AccountAutoSync => "system",
            _ => "other"
        };
    }

    private string GetCategoryName(string taskType) => GetCategoryDisplayName(GetCategory(taskType));

    private Color GetCategoryColor(string taskType) => GetCategoryColorByCategory(GetCategory(taskType));

    private static string GetCategoryDisplayName(string category) => category switch
    {
        "user" => "用户任务",
        "bot" => "Bot 任务",
        "system" => "系统任务",
        _ => string.IsNullOrWhiteSpace(category) ? "-" : category
    };

    private static Color GetCategoryColorByCategory(string category) => category switch
    {
        "user" => Color.Info,
        "bot" => Color.Secondary,
        "system" => Color.Default,
        _ => Color.Default
    };

    private string GetTaskIcon(string type)
    {
        if (!string.IsNullOrWhiteSpace(type)
            && Contributions.TaskTypeToDefinition.TryGetValue(type, out var reg)
            && !string.IsNullOrWhiteSpace(reg.Definition.Icon))
            return reg.Definition.Icon;

        return type switch
        {
            BatchTaskTypes.AccountAutoSync => Icons.Material.Filled.Sync,
            _ => Icons.Material.Filled.Task
        };
    }

    private string GetTaskTypeName(string type)
    {
        if (!string.IsNullOrWhiteSpace(type)
            && Contributions.TaskTypeToDefinition.TryGetValue(type, out var reg)
            && !string.IsNullOrWhiteSpace(reg.Definition.DisplayName))
            return reg.Definition.DisplayName;

        return type switch
        {
            BatchTaskTypes.UserChatActive => "账号持续活跃（群组/频道/Bot）",
            BatchTaskTypes.BotChannelSetAdminsByAccount => "Bot频道批量设置管理员（账号执行）",
            BatchTaskTypes.BotSetAdmins => "Bot频道批量设置管理员（机器人执行）",
            BatchTaskTypes.AccountAutoSync => "账号数据同步",
            _ => type
        };
    }

    private string GetStatusName(string status) => status switch
    {
        "pending" => "待执行",
        "running" => "执行中",
        "paused" => "已暂停",
        "completed" => "已完成",
        "failed" => "失败",
        "canceled" => "已取消",
        _ => status
    };

    private Color GetStatusColor(string status) => status switch
    {
        "completed" => Color.Success,
        "running" => Color.Info,
        "paused" => Color.Warning,
        "pending" => Color.Default,
        "failed" => Color.Error,
        "canceled" => Color.Secondary,
        _ => Color.Default
    };

    private Color GetProgressColor(string status) => status switch
    {
        "completed" => Color.Success,
        "running" => Color.Primary,
        "paused" => Color.Warning,
        "failed" => Color.Error,
        "canceled" => Color.Secondary,
        _ => Color.Default
    };

    private static string GetDisplayStatus(BatchTask task)
    {
        if (task.Status == "failed" && task.CompletedAt.HasValue && task.Total > 0 && task.Completed >= task.Total)
            return "completed";

        return task.Status;
    }

    private static bool IsActiveStatus(string status) =>
        status is "pending" or "running" or "paused";

    private static bool IsHistoryStatus(string status) =>
        status is "completed" or "failed" or "canceled";

    private static string GetScheduledStatusName(string status) =>
        string.Equals((status ?? string.Empty).Trim(), ScheduledTaskStatuses.Paused, StringComparison.OrdinalIgnoreCase)
            ? "已暂停"
            : "启用中";

    private static Color GetScheduledStatusColor(string status) =>
        string.Equals((status ?? string.Empty).Trim(), ScheduledTaskStatuses.Paused, StringComparison.OrdinalIgnoreCase)
            ? Color.Warning
            : Color.Success;

    private string GetScheduledTaskName(ScheduledTask task) =>
        string.IsNullOrWhiteSpace(task.Name)
            ? $"{GetTaskTypeName(task.TaskType)} #{task.Id}"
            : task.Name.Trim();

    private void ShowTaskDetails(BatchTask task)
    {
        var createdAt = TimeZone.Format(task.CreatedAt, "yyyy-MM-dd HH:mm");
        var displayStatus = GetDisplayStatus(task);
        var details = $"任务类型: {GetTaskTypeName(task.TaskType)}\n" +
                     $"状态: {GetStatusName(displayStatus)}\n" +
                     $"总数: {task.Total}\n" +
                     $"已完成: {task.Completed}\n" +
                     $"失败: {task.Failed}\n" +
                     $"创建时间: {createdAt}\n";

        if (task.StartedAt.HasValue)
            details += $"开始时间: {TimeZone.Format(task.StartedAt.Value, "yyyy-MM-dd HH:mm")}\n";

        if (task.CompletedAt.HasValue)
            details += $"完成时间: {TimeZone.Format(task.CompletedAt.Value, "yyyy-MM-dd HH:mm")}\n";

        var failureLines = ExtractBotAdminFailureLines(task);
        if (failureLines.Count > 0)
            details += $"\n失败频道:\n{string.Join('\n', failureLines)}";
        else if (IsUserChatActiveTask(task.TaskType) && TryBuildUserChatActiveDetails(task, out var activeDetails))
            details += activeDetails;
        else if (!IsBotAdminTask(task.TaskType) && TryBuildReadableConfigDetails(task.TaskType, task.Config, out var configDetails))
            details += $"\n配置摘要:\n{configDetails}";

        var html = System.Net.WebUtility.HtmlEncode(details)
            .Replace("\r\n", "\n", StringComparison.Ordinal)
            .Replace("\n", "<br/>", StringComparison.Ordinal);
        DialogService.ShowMessageBox("任务详情", (MarkupString)html);
    }

    private static bool IsBotAdminTask(string taskType) =>
        taskType is BatchTaskTypes.BotChannelSetAdminsByAccount or BatchTaskTypes.BotSetAdmins;

    private static bool IsUserChatActiveTask(string taskType) =>
        string.Equals((taskType ?? string.Empty).Trim(), BatchTaskTypes.UserChatActive, StringComparison.OrdinalIgnoreCase);

    private RegisteredTaskDefinition? GetTaskDefinition(BatchTask task)
    {
        var taskType = (task.TaskType ?? string.Empty).Trim();
        if (taskType.Length == 0)
            return null;

        return Contributions.TaskTypeToDefinition.TryGetValue(taskType, out var definition)
            ? definition
            : null;
    }

    private static string? NormalizeNullableText(string? value)
    {
        var text = (value ?? string.Empty).Trim();
        if (text.Length == 0)
            return null;

        return StripRuntimeFields(text);
    }

    private bool TryBuildReadableConfigDetails(string taskType, string? config, out string details)
    {
        details = string.Empty;
        if (string.IsNullOrWhiteSpace(config))
            return false;

        try
        {
            using var doc = JsonDocument.Parse(config);
            var root = doc.RootElement;
            if (root.ValueKind != JsonValueKind.Object)
            {
                details = config.Trim();
                return true;
            }

            var lines = taskType switch
            {
                BatchTaskTypes.ChannelGroupPrivateCreate => BuildPrivateCreateConfigLines(root),
                BatchTaskTypes.ChannelGroupPublicize => BuildPublicizeConfigLines(root),
                BatchTaskTypes.AccountAutoSync => BuildAccountSyncConfigLines(root),
                _ => BuildGenericConfigLines(root)
            };

            details = string.Join('\n', lines);
            return details.Length > 0;
        }
        catch
        {
            details = config.Trim();
            return details.Length > 0;
        }
    }

    private List<string> BuildPrivateCreateConfigLines(JsonElement root)
    {
        var createType = GetJsonString(root, "create_type", ChannelGroupAutomationTaskObjectTypes.Channel);
        var lines = new List<string>
        {
            $"账号分类: {BuildSelectedCategorySummary(root)}",
            $"创建对象: {GetObjectTypeName(createType)}",
            $"{(createType == ChannelGroupAutomationTaskObjectTypes.Group ? "群组分类" : "频道分组")}: {GetChatGroupName(root, createType)}",
            $"每账号累计创建上限: {GetJsonInt(root, "system_created_limit", 10)}",
            $"本轮每账号创建数: {GetJsonInt(root, "per_account_batch_size", 1)}",
            $"间隔: {FormatSecondsValue(GetJsonInt(root, "min_delay_seconds", 0))} ~ {FormatSecondsValue(GetJsonInt(root, "max_delay_seconds", 0))} 秒",
            $"时间抖动: {GetJsonInt(root, "jitter_percent", 0)}%",
            $"标题模板: {GetJsonString(root, "title_template", "-")}",
            $"头像来源: {GetAvatarSourceName(root)}"
        };

        var failures = BuildChannelGroupAutomationFailureLines(root);
        if (failures.Count > 0)
        {
            lines.Add(string.Empty);
            lines.Add("最近失败:");
            lines.AddRange(failures);
        }

        return lines;
    }

    private List<string> BuildChannelGroupAutomationFailureLines(JsonElement root)
    {
        var lines = new List<string>();
        if (!root.TryGetProperty("recent_failures", out var failures) || failures.ValueKind != JsonValueKind.Array)
            return lines;

        foreach (var item in failures.EnumerateArray().TakeLast(20))
        {
            if (item.ValueKind != JsonValueKind.Object)
                continue;

            var accountId = GetJsonInt(item, "account_id", 0);
            var account = accountId > 0 ? $"账号 #{accountId}" : "账号 -";
            var targetType = GetObjectTypeName(GetJsonString(item, "target_type", ChannelGroupAutomationTaskObjectTypes.Channel));
            var target = GetJsonString(item, "target", "-");
            var reason = GetJsonString(item, "reason", "失败");
            var time = FormatTaskFailureTime(GetJsonString(item, "time_utc", string.Empty));
            lines.Add($"{account} -> {targetType}「{target}」：{reason}{(time.Length > 0 ? $"（{time}）" : string.Empty)}");
        }

        return lines;
    }

