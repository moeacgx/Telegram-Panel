{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=telegram_panel.db"
  },
  "Telegram": {
    "ApiId": 0,
    "ApiHash": "",
    "OfficialApiEnabled": true,
    "SessionsPath": "sessions",
    "DefaultDelayMs": 2000,
    "MaxRetries": 3
  },
  "Proxy": {
    "Warp": {
      "Enabled": false,
      "DockerSocketPath": "/var/run/docker.sock",
      "Image": "caomingjun/warp:latest",
      "Network": "telegram-panel_default",
      "ContainerPrefix": "telegram-panel-warp",
      "Protocol": "http",
      "ContainerPort": 1080,
      "HostPortStart": 42080,
      "ProxyHostMode": "container",
      "ProxyHost": "127.0.0.1",
      "PullIfMissing": true,
      "MaxManagedProxyCount": 0,
      "Container": {
        "MemoryLimitBytes": 0,
        "CpuLimit": 0,
        "PidsLimit": 0
      }
    }
  },
  "TelegramStatus": {
    "AutoRefreshTransientFailures": true,
    "AutoRefreshIntervalMinutes": 30,
    "AutoRefreshBatchSize": 3,
    "AutoRefreshMinAgeMinutes": 10,
    "AutoRefreshDelayMs": 5000
  },
  "ScheduledTasks": {
    "RandomDelaySeconds": 300
  },
  "PersistentModuleTasks": {
    "Enabled": true,
    "PollIntervalSeconds": 2,
    "MaxConcurrent": 4
  },
  "AdminAuth": {
    "Enabled": true,
    "InitialUsername": "tgpanel",
    "InitialPassword": "tgpanel123",
    "CredentialsPath": "admin_auth.json"
  },
  "Hangfire": {
    "DashboardPath": "/hangfire"
  },
  "Serilog": {
    "Enabled": false,
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "RetainedFileCountLimit": 30
  },
  "AllowedHosts": "*"
}
