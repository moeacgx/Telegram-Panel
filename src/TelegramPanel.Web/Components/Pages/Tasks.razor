    private static List<string> BuildAccountSyncConfigLines(JsonElement root)
    {
        var lines = new List<string>
        {
            $"触发方式: {GetSyncTriggerName(GetJsonString(root, "trigger", ""))}",
            $"同步范围: {GetSyncScopeName(GetJsonString(root, "scope", ""))}"
        };

        var includes = GetJsonStringArray(root, "includes").Select(GetSyncFlagName).ToList();
        if (includes.Count > 0)
            lines.Add($"包含内容: {string.Join(", ", includes)}");

        var excludes = GetJsonStringArray(root, "excludes").Select(GetSyncFlagName).ToList();
        if (excludes.Count > 0)
            lines.Add($"排除内容: {string.Join(", ", excludes)}");

        if (root.TryGetProperty("progress", out var progress) && progress.ValueKind == JsonValueKind.Object)
            lines.Add($"进度记录: 账号 {GetJsonInt(progress, "processedAccounts", 0)} / {GetJsonInt(progress, "totalAccounts", 0)}，失败 {GetJsonInt(progress, "failedAccounts", 0)}");

        if (root.TryGetProperty("result", out var result) && result.ValueKind == JsonValueKind.Object)
            lines.Add($"同步结果: 频道 {GetJsonInt(result, "totalChannelsSynced", 0)}，群组 {GetJsonInt(result, "totalGroupsSynced", 0)}");

        var failureCount = GetJsonArrayCount(root, "failures");
        if (failureCount > 0)
            lines.Add($"失败记录: {failureCount} 条");

        var error = GetJsonString(root, "error", "");
        if (!string.IsNullOrWhiteSpace(error))
            lines.Add($"错误: {error}");

        return lines;
    }

    private static List<string> BuildGenericConfigLines(JsonElement root)
    {
        var lines = new List<string>();
        foreach (var prop in root.EnumerateObject())
        {
            if (string.Equals(prop.Name, "recent_failures", StringComparison.OrdinalIgnoreCase) || IsEmptyJsonValue(prop.Value))
                continue;

            lines.Add($"{GetConfigKeyName(prop.Name)}: {FormatJsonConfigValue(prop.Value)}");
        }

        return lines;
    }

    private static string GetJsonString(JsonElement root, string propertyName, string fallback = "-")
    {
        if (!root.TryGetProperty(propertyName, out var value) || value.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined)
            return fallback;

        var text = value.ValueKind == JsonValueKind.String ? value.GetString() : value.ToString();
        text = (text ?? string.Empty).Trim();
        return text.Length == 0 ? fallback : text;
    }

    private static int GetJsonInt(JsonElement root, string propertyName, int fallback = 0)
    {
        if (!root.TryGetProperty(propertyName, out var value))
            return fallback;

        if (value.TryGetInt32(out var number))
            return number;

        return int.TryParse(value.ToString(), out number) ? number : fallback;
    }

    private static int GetJsonArrayCount(JsonElement root, string propertyName) =>
        root.TryGetProperty(propertyName, out var value) && value.ValueKind == JsonValueKind.Array
            ? value.GetArrayLength()
            : 0;

    private static List<string> GetJsonStringArray(JsonElement root, string propertyName)
    {
        var values = new List<string>();
        if (!root.TryGetProperty(propertyName, out var array) || array.ValueKind != JsonValueKind.Array)
            return values;

        foreach (var item in array.EnumerateArray())
        {
            var value = FormatJsonConfigValue(item).Trim();
            if (value.Length > 0 && value != "-")
                values.Add(value);
        }

        return values;
    }

    private static bool IsEmptyJsonValue(JsonElement value) =>
        value.ValueKind switch
        {
            JsonValueKind.Null or JsonValueKind.Undefined => true,
            JsonValueKind.String => string.IsNullOrWhiteSpace(value.GetString()),
            JsonValueKind.Array => value.GetArrayLength() == 0,
            JsonValueKind.Object => !value.EnumerateObject().Any(),
            _ => false
        };

    private static string FormatJsonConfigValue(JsonElement value)
    {
        return value.ValueKind switch
        {
            JsonValueKind.Null or JsonValueKind.Undefined => "-",
            JsonValueKind.String => string.IsNullOrWhiteSpace(value.GetString()) ? "-" : value.GetString()!.Trim(),
            JsonValueKind.Number => value.ToString(),
            JsonValueKind.True => "是",
            JsonValueKind.False => "否",
            JsonValueKind.Array => FormatJsonArrayValue(value),
            JsonValueKind.Object => FormatJsonObjectValue(value),
            _ => value.ToString()
        };
    }

    private static string FormatJsonArrayValue(JsonElement value)
    {
        var items = value.EnumerateArray().ToList();
        if (items.Count == 0)
            return "-";

        if (items.All(x => x.ValueKind is JsonValueKind.String or JsonValueKind.Number or JsonValueKind.True or JsonValueKind.False or JsonValueKind.Null))
        {
            var displayItems = items.Take(8).Select(FormatJsonConfigValue).ToList();
            return items.Count > displayItems.Count
                ? $"{string.Join(", ", displayItems)} 等 {items.Count} 项"
                : string.Join(", ", displayItems);
        }

        return $"{items.Count} 项";
    }

    private static string FormatJsonObjectValue(JsonElement value)
    {
        var parts = value.EnumerateObject()
            .Where(x => !IsEmptyJsonValue(x.Value))
            .Take(8)
            .Select(x => $"{GetConfigKeyName(x.Name)} {FormatJsonConfigValue(x.Value)}")
            .ToList();

        return parts.Count == 0 ? "-" : string.Join("，", parts);
    }

    private static string FormatSecondsValue(int seconds) =>
        seconds <= 0 ? "0" : seconds.ToString("0.###");

